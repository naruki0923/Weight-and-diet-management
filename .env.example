# このファイルをコピーして .env を作り、値を埋める（.env はGitに含めない）

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Gemini
GEMINI_API_KEY=

# Google スプレッドシート「体重・食事管理」
SPREADSHEET_URL_OR_KEY=

# サービスアカウントの鍵。ローカルはファイルパス、VercelはJSONの中身をそのまま貼る
GCP_SERVICE_ACCOUNT_JSON=credentials.json

# iOSショートカットからAPIを叩くときの合言葉
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
